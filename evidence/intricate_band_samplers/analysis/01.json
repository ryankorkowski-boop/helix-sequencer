  "lyric_refinement": {
    "method": "retain recognized vocables; adopt screened embedded-reference alignments where available",
    "accepted_reference_segments": [
      {
        "start_ms": 13360,
        "end_ms": 16180,
        "text": "Creepin' through the town, sack on my back,",
        "median_word_confidence": 0.7842826098203659,
        "independent_recognized_token_agreement": 7
      },
      {
        "start_ms": 16180,
        "end_ms": 18980,
        "text": "Grinch on the mic, heart black as the track.",
        "median_word_confidence": 0.8353235125541687,
        "independent_recognized_token_agreement": 8
      },
      {
        "start_ms": 18980,
        "end_ms": 21700,
        "text": "Thought the loot was the root, stole it all in a flash,",
        "median_word_confidence": 0.9419730305671692,
        "independent_recognized_token_agreement": 8
      },
      {
        "start_ms": 22000,
        "end_ms": 25100,
        "text": "Tinsel, bows, roast beast, even snatched the stash.",
        "median_word_confidence": 0.6315851248800755,
        "independent_recognized_token_agreement": 2
      },
      {
        "start_ms": 25100,
        "end_ms": 27420,
        "text": "Cindy Lou caught me, wide eyes, no fear,",
        "median_word_confidence": 0.6809960007667542,
        "independent_recognized_token_agreement": 7
      },
      {
        "start_ms": 28060,
        "end_ms": 30440,
        "text": "Said, \"Why you takin' Christmas? What's your deal here?\"",
        "median_word_confidence": 0.8349061608314514,
        "independent_recognized_token_agreement": 7
      },
      {
        "start_ms": 30860,
        "end_ms": 33480,
