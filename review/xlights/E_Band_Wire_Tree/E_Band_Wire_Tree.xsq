<?xml version='1.0' encoding='utf-8'?>
<xsequence BaseChannel="1" FixedPointTiming="1" ModelBlending="true">
  <head>
    <version>2026.18</version>
    <author>Helix</author>
    <song>E_Band_Wire_Tree</song>
